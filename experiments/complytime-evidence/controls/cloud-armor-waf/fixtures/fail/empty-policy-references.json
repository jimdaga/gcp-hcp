{
  "target": {
    "id": "synthetic-public-backend",
    "internetFacing": true
  },
  "backendService": {
    "name": "synthetic-backend-service",
    "securityPolicy": "",
    "logConfig": {
      "enable": true,
      "sampleRate": 1.0
    }
  },
  "securityPolicy": {
    "name": "sample-waf",
    "selfLink": "",
    "rules": [
      {
        "priority": 1000,
        "action": "deny(403)",
        "preview": false,
        "match": {
          "expr": {
            "expression": "evaluatePreconfiguredWaf('sqli-v33-stable')"
          }
        }
      },
      {
        "priority": 2147483647,
        "action": "allow",
        "match": {
          "versionedExpr": "SRC_IPS_V1"
        }
      }
    ]
  }
}
