{
  "target": {
    "id": "synthetic-public-backend",
    "internetFacing": true
  },
  "backendService": {
    "name": "synthetic-backend-service",
    "securityPolicy": "https://www.googleapis.com/compute/v1/projects/synthetic-project/global/securityPolicies/sample-waf",
    "logConfig": {
      "enable": true,
      "sampleRate": 1.0
    }
  },
  "securityPolicy": {
    "name": "sample-waf",
    "selfLink": "https://www.googleapis.com/compute/v1/projects/synthetic-project/global/securityPolicies/sample-waf",
    "rules": [
      {
        "priority": 1000,
        "action": "throttle",
        "preview": false,
        "match": {
          "expr": {
            "expression": "origin.region_code == 'US'"
          }
        }
      },
      {
        "priority": 2147483647,
        "action": "allow",
        "match": {
          "versionedExpr": "SRC_IPS_V1"
        }
      }
    ]
  }
}
